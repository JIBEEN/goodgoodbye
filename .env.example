# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이거나 브라우저로 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 서버 전용 비밀값. 각각 `openssl rand -base64 32` 등으로 생성 (서로 다른 값 사용)
# 배포 후 LETTER_PASSWORD_PEPPER를 바꾸면 기존 편지 비밀번호가 모두 무효가 됩니다.
LETTER_PASSWORD_PEPPER=
LETTER_AUTH_SECRET=
